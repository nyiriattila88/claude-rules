{
  "_comment": "Merge the hooks block below into ~/.claude/settings.json (user scope, so it applies to every project). Keep the rest of that file intact and adjust the absolute paths to where this repo is cloned. On macOS/Linux replace powershell.exe and its args with the equivalent shell invocation.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "C:\\Users\\nyiria\\source\\repos\\claude-rules\\.claude\\hooks\\session-start-lessons.ps1"
            ],
            "timeout": 15,
            "statusMessage": "Workspace tanulságok betöltése"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "C:\\Users\\nyiria\\source\\repos\\claude-rules\\.claude\\hooks\\stop-lessons-sweep.ps1"
            ],
            "timeout": 15,
            "statusMessage": "Tanulság-ellenőrzés"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "C:\\Users\\nyiria\\source\\repos\\claude-rules\\.claude\\hooks\\post-tool-use-skill-marker.ps1"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(aws *)",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "C:\\Users\\nyiria\\source\\repos\\claude-rules\\.claude\\hooks\\pre-tool-use-official-skills.ps1"
            ],
            "timeout": 15
          },
          {
            "type": "command",
            "if": "PowerShell(aws *)",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "C:\\Users\\nyiria\\source\\repos\\claude-rules\\.claude\\hooks\\pre-tool-use-official-skills.ps1"
            ],
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "mcp__plugin_aws-core_aws-mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "C:\\Users\\nyiria\\source\\repos\\claude-rules\\.claude\\hooks\\pre-tool-use-official-skills.ps1"
            ],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
